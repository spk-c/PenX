# Local LLM server (LM Studio default). LM Studio: http://127.0.0.1:1234
# Ollama OpenAI-compatible endpoint: http://127.0.0.1:11434
# llama.cpp / NInfer (port 8080): http://127.0.0.1:8080
# vLLM (often port 8000): http://127.0.0.1:8000
# SGLang (often port 30000): http://127.0.0.1:30000
# Other OpenAI-compatible servers are supported when their chat API is compatible.
# Use PenX --llm-setup, option [5], to discover unauthenticated localhost APIs.
# A rejected nonstandard top_k sampler is retried once without it.
# Accepts server root or /v1 URL; /v1/chat/completions is also accepted.
PENX_LLM_URL=http://127.0.0.1:1234
# Set the model id displayed by your server, or use auto if exactly ONE is listed.
# llama.cpp model IDs may be paths unless you start llama-server with --alias.
# Example: PENX_MODEL=auto
PENX_MODEL=your-local-model
# Optional API key, e.g. llama-server --api-key (leave unset for localhost without auth):
# PENX_LLM_API_KEY=
PENX_MAX_TOKENS=8192
# Qwen and other thinking models may exhaust their output tokens without an
# answer; retry ONCE non-streaming with /no_think on empty output.
PENX_LLM_RETRY_EMPTY=on
PENX_LLM_RETRY_TOKENS=16384
PENX_TIMEOUT=600
PENX_MAX_LOOPS=9

# auto tries JSON schema and falls back to legacy text; strict requires JSON; off disables JSON.
PENX_STRUCTURED_OUTPUT=auto
# Look up CVE references with NVD and CISA KEV. CVE IDs (not target data) leave the PC.
PENX_VERIFY_SOURCES=on
# Optional NVD rate-limit API key; keep only in your private .env:
# PENX_NVD_API_KEY=

# Version-aware CVE discovery from Nmap XML CPEs and explicit package PURLs.
# Sources: NVD, OSV and GitHub Advisory DB. Requests disclose product/version only.
PENX_CVE_DISCOVERY=on
PENX_CVE_MAX_SERVICES=3
PENX_CVE_MAX_PACKAGES=4
PENX_CVE_MAX_RESULTS=15
PENX_CVE_PRIORITY=on
PENX_CVE_MAX_VERIFY=20
# Only set if you actually know the target distribution:
# PENX_CVE_DISTRO_HINT=ubuntu:jammy
# PENX_CVE_DISTRO_HINT=debian:bookworm
# PENX_CVE_DISTRO_HINT=rhel:9
# Optional explicit source-package/version inventory exported from a machine YOU manage:
# PENX_PACKAGE_INVENTORY=C:/PenX/inventory.json
# Optional local Debian Security Tracker data JSON (large upstream file, downloaded by you):
# PENX_DEBIAN_TRACKER_JSON=C:/PenX/debian-tracker.json
# Optional public GitHub API rate-limit token (keep private):
# PENX_GITHUB_ADVISORY_TOKEN=

# Shodan InternetDB: passive public IPv4 metadata; no API key needed.
# Enabled automatically in [9] Passive-Only Recon (third party receives queried IP).
# Shodan's free InternetDB is intended for non-commercial use; check its terms.
PENX_SHODAN_INTERNETDB=on
# Limit DNS A-record lookups per domain (1-5) to reduce requests and disclosure.
PENX_SHODAN_MAX_IPS=3
# Optional Shodan Host API key (plan/membership access required for detailed host data).
# Never share or commit a real key.
# PENX_SHODAN_API_KEY=
# Optional Censys external index (also requires its own credentials).
# PENX_CENSYS_API_ID=
# PENX_CENSYS_API_SECRET=

# Native SQLite default: no separate database service required.
PENX_DB_ENGINE=sqlite
# Optional: PENX_DB_PATH=C:/Users/YourName/Documents/penx.db

# Optional Nmap.exe path, normally auto-detected:
# PENX_NMAP_PATH=C:/Program Files (x86)/Nmap/nmap.exe
# WhatWeb and Nikto are downloaded automatically to vendor/ by install-windows.bat.
# Optional overrides for already installed copies or custom interpreters:
# PENX_NIKTO_PATH=C:/Tools/nikto/program/nikto.pl
# PENX_WHATWEB_PATH=C:/Tools/WhatWeb/whatweb
# PENX_PERL_PATH=C:/Strawberry/perl/bin/perl.exe
# PENX_RUBY_PATH=C:/Ruby34-x64/bin/ruby.exe


# Individual scanner deadlines (seconds). Separate from PENX_TIMEOUT (LLM).
# Defaults shown. Limits: 30..900 seconds; use lower values for fast checks,
# larger values for particularly slow authorized websites.
PENX_NIKTO_TIMEOUT=300
PENX_NUCLEI_TIMEOUT=240

# Resource-aware Full Scan: when selected recon reports HTTP 508, PenX skips
# additional active HTTP scanners (Nikto, Nuclei, httpx, ffuf, Katana) and
# retains a PARTIAL assessment. Other independent checks can still run.
#
# PDF original-AI appendix: compact (default) prevents 10+ pages of raw transcript;
# the full audit stays in the saved DB and offline HTML report.
# PENX_PDF_AI_APPENDIX=full

# Optional native scanners: download verified Windows EXEs with PenX.exe --setup-native.
# Existing installations may be specified via absolute paths:
# PENX_NUCLEI_PATH=C:/PenX/vendor/bin/nuclei.exe
# PENX_HTTPX_PATH=C:/PenX/vendor/bin/httpx.exe
# PENX_FFUF_PATH=C:/PenX/vendor/bin/ffuf.exe
# Optional ffuf wordlist (max 80 safe, relative, same-origin paths, max 8 KiB):
# PENX_FFUF_WORDLIST=C:/PenX/wordlists/my-paths.txt

# To use a pre-existing MariaDB instead of SQLite:
# PENX_DB_ENGINE=mariadb
# PENX_DB_HOST=localhost
# PENX_DB_USER=penx
# PENX_DB_PASS=change-me
# PENX_DB_NAME=penx

# Model-created external searches may disclose scan text. Off by default;
# when explicitly enabled, only standalone public CVE IDs can be queried.
PENX_ALLOW_MODEL_WEB_SEARCH=off
