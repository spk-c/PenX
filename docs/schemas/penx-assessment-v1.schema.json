{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spk-c/PenX/schemas/penx-assessment-v1",
  "title": "PenX saved assessment v1",
  "type": "object",
  "required": ["schema", "session", "target", "scan_date", "risk", "findings", "limitations"],
  "properties": {
    "schema": {"const": "penx-assessment-v1"},
    "session": {"type": "integer", "minimum": 1},
    "target": {"type": "string"},
    "scan_date": {"type": "string"},
    "risk": {"type": "string"},
    "php2shell": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "rule", "fingerprint", "name", "severity", "confidence", "status", "port", "service", "description", "evidence", "evidence_ref"],
      "properties": {
        "id": {"type": "integer"},
        "rule": {"type": "string"},
        "fingerprint": {"type": "string", "pattern": "^penx-finding-v1:[a-f0-9]{64}$"},
        "name": {"type": "string"},
        "severity": {"type": "string"},
        "confidence": {"type": "string"},
        "status": {"enum": ["review-required", "scanner-quote-matched"]},
        "port": {"type": "string"},
        "service": {"type": "string"},
        "description": {"type": "string"},
        "evidence": {"type": "string"},
        "evidence_ref": {"type": ["string", "null"]},
        "raw_evidence": {"type": "string"},
        "scanner": {"type": ["string", "null"]},
        "scanner_version": {"type": ["string", "null"]},
        "scanner_status": {"enum": ["COMPLETE", "PARTIAL", "FAILED", "UNKNOWN"]},
        "evidence_recorded_at": {"type": ["string", "null"]},
        "raw_artifact": {"type": ["object", "null"]},
        "artifact_status": {"enum": ["not-retained", "stored-reference-not-revalidated"]}
      }
    }
  }
}
